# Google AI Studio API Key for Gemma 4 IT models
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key for alternative Llama 3 models
GROQ_API_KEY=your_groq_api_key_here

# LLM Provider: 'gemini' or 'groq'
LLM_PROVIDER=groq

# Model Name: e.g. 'llama-3.3-70b-versatile' for Groq or 'gemma-4-31b-it' for Gemini
LLM_MODEL=llama-3.3-70b-versatile

# HuggingFace User Access Token for streaming datasets
HF_TOKEN=your_huggingface_token_here

# Supabase Project Connection Details
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Mock authentication settings for local testing (set to true to bypass OAuth check)
MOCK_AUTH=true

# Confidence Gate Threshold for RAG query routing (calibrated from precision-recall curve)
CONFIDENCE_THRESHOLD=0.65
