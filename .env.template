# Google AI Studio API Key for Gemini models
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key for open-weights models
GROQ_API_KEY=your_groq_api_key_here

# LLM Provider: 'gemini' (default) or 'groq' (fallback)
LLM_PROVIDER=gemini

# Model Name: 'gemini-3.6-flash' (default for Gemini) or 'openai/gpt-oss-120b' (for Groq)
LLM_MODEL=gemini-3.6-flash

# HuggingFace User Access Token for streaming datasets
HF_TOKEN=your_huggingface_token_here

# Supabase Project Connection Details
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Supabase direct PostgreSQL connection string.
# NOTE: Not consumed by the application — SQLChatMessageHistory has been
# removed. Conversation history is sourced exclusively from db_manager
# (the `messages` table via supabase-py or local JSON fallback).
# Keep this for direct DB access / migrations via psql or Supabase CLI.
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# IMPORTANT: MOCK_AUTH must be false in production.
# true = all requests share one hardcoded UUID, bypassing all authentication.
# Only set to true explicitly for local development without Supabase.
# WARNING: accidentally deploying with MOCK_AUTH=true exposes all users' data.
MOCK_AUTH=false

# Confidence Gate Threshold for RAG query routing (calibrated from precision-recall curve)
CONFIDENCE_THRESHOLD=0.65

# CORS: comma-separated list of allowed origins (no wildcard in production)
# Example for HF Spaces: https://your-space.hf.space,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8001,http://127.0.0.1:8001

# Rate limiting for /query endpoint (slowapi format: "N/period")
QUERY_RATE_LIMIT=10/minute

# Session chunk cache TTL in seconds (default 1800 = 30 minutes)
CACHE_TTL_SECONDS=1800
